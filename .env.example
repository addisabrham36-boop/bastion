# Bastion-TIP Configuration Template
BASTION_ENV=development
BASTION_LOG_LEVEL=INFO
BASTION_LISTEN_HOST=127.0.0.1
BASTION_LISTEN_PORT=9000
BASTION_PUBLIC_BASE_URL=http://127.0.0.1:9000
BASTION_SITE_CONFIG=bastion/config/sites.yaml
BASTION_RULE_CONFIG=bastion/config/rules.yaml
BASTION_DEFAULT_MODE=detection
BASTION_MAX_BODY_BYTES=1048576
BASTION_MAX_PATH_BYTES=8192
BASTION_MAX_HEADER_BYTES=32768
BASTION_UPSTREAM_TIMEOUT_SECONDS=15.0
BASTION_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_EVENT_STREAM=bastion:events:v1

# OpenSearch Configuration
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CHANGE_ME_IN_PRODUCTION
OPENSEARCH_VERIFY_TLS=false

# Security & Dashboard API
BASTION_SESSION_SECRET=CHANGE_ME_WITH_A_SECURE_RANDOM_SECRET_KEY
BASTION_ADMIN_NETWORKS=127.0.0.1/32,::1/128
